DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
GUILD_ID=your-test-server-id-here
VOICE_CHANNEL_ID=your-voice-channel-id-here
# Optional: path to a Python executable with faster-whisper installed, used for
# local (free) voice command transcription. Defaults to a known path on this machine.
# PYTHON_PATH=C:/Program Files/Python314/python.exe

# Optional: "hey diddy, I have a question: ..." and /ask use the Perplexity Agent API
# (falls back to Fast Search if it fails). Create a key at https://console.perplexity.ai
# PERPLEXITY_API_KEY=your-api-key
