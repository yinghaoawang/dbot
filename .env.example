DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
GUILD_ID=your-test-server-id-here
VOICE_CHANNEL_ID=your-voice-channel-id-here
# Optional: path to a Python executable with faster-whisper installed, used for
# local (free) voice command transcription. Defaults to a known path on this machine.
# PYTHON_PATH=C:/Program Files/Python314/python.exe

# Optional: "hey diddy, I have a question: ..." and /ask use the Perplexity Orchestrator API.
# Create a key at https://console.perplexity.ai. LLM_MODEL is a `creator/model-name` slug;
# list the ones your key can use with:
#   curl https://api.perplexity.ai/orchestrator/v1/models -H "Authorization: Bearer $PERPLEXITY_API_KEY"
# PERPLEXITY_API_KEY=your-api-key
# LLM_MODEL=perplexity/glm-5.3-flash
# LLM_MAX_WORDS=34
